# ============================================================
# AI Business Workforce — Example environment file
# Copy to .env and replace with real values.
# NEVER commit real secrets to git.
# ============================================================

# --- Application ---
APP_NAME="AI Business Workforce"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PREFIX=/api/v1

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite:///./ai_business_workforce.db
# PostgreSQL (production) — example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_business_workforce

# --- Security / JWT ---
# Use a long (>= 64 char) random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for dev only
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Email adapter ---
# Provider: smtp | console | noop  (console prints to stdout in dev)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME="AI Business Workforce"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true

# --- Exchange rate provider ---
# Provider: mock | manual | openexchangerates | frankfurter
EXCHANGE_RATE_PROVIDER=mock
OPENEXCHANGERATES_APP_ID=your-app-id-here

# --- bcrypt rounds ---
BCRYPT_ROUNDS=12

# --- Frontend base URL (used in verification / reset emails) ---
FRONTEND_BASE_URL=http://localhost:3000
